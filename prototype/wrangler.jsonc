{
	// Cloudflare Pages set-up for the site: the built pages in dist/, plus functions/ (the email endpoint, and the door to the live demo).
	//
	// First deploy, from this folder:
	//   npm install
	//   npx wrangler login
	//   npx wrangler d1 create locus-leads --binding DB --update-config
	//       (creates the database that keeps the emails, and writes it into this file by itself)
	//   npm run deploy
	//
	// Later deploys:   npm run deploy
	// Read the emails: npm run leads
	"name": "locus",
	"compatibility_date": "2026-11-01",
	"pages_build_output_dir": "dist",
	// the live demo: /api/demo/* (functions/api/demo/) hands every request to the locus-demo Worker
	// (demo/worker/). Not bound yet: Cloudflare refuses to deploy a binding to a Worker that does not
	// exist, and the Worker is not deployed. Until then /api/demo/* answers 503 "not set up yet".
	// After deploying the Worker, add this back:
	//   "services": [ { "binding": "DEMO", "service": "locus-demo" } ],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "locus-leads",
			"database_id": "140765d8-9980-4376-a66e-28fde68e7b29"
		}
	]
}