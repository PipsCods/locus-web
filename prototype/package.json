{
  "name": "locus-prototype",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cf:dev": "vite build && wrangler pages dev",
    "deploy": "vite build && wrangler pages deploy",
