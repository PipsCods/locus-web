# installed packages and build output: recreated by "npm install" and "npm run build"
node_modules/
dist/

# a stray, empty lock file at the top level; the real one lives in prototype/
/package-lock.json

# Cloudflare's local working files, and the secrets its local runner reads
.wrangler/
.dev.vars*
.env
.env.*
!.env.example

# emails collected by the local dev server while testing the "Check your server" form
.leads.dev.jsonl

# preview screenshots for reviewing designs: kept on disk, not used by the site
prototype/previews/
mockups/previews/

# working files of AI coding tools: session state, recordings and personal settings
.omc/
.claude/settings.local.json
.claude/worktrees/
.claude/bench-results/
graphify-out/

# editors and machine clutter
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

# Python bytecode (demo/instance/loadgen.py)
__pycache__/
